rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidDiary(data) {
      return data.id is string 
        && isValidId(data.id)
        && data.title is string && data.title.size() <= 1000
        && data.content is string && data.content.size() <= 100000
        && data.date is string && data.date.size() <= 50
        && data.time is string && data.time.size() <= 50
        && data.location is map
        && data.rating is number && data.rating >= 0 && data.rating <= 5;
    }

    // Connection health check document
    match /test/connection {
      allow read: if true;
    }

    // Hill's Blog travel diaries collection
    match /diaries/{diaryId} {
      allow read: if true;
      allow create, update: if isValidId(diaryId) && isValidDiary(request.resource.data) && request.resource.data.id == diaryId;
      allow delete: if isValidId(diaryId);

      // Attached photos subcollection (allows up to 3MB+ attached photos with chunking)
      match /photos/{photoId} {
        allow read, write, delete: if isValidId(diaryId);

        match /chunks/{chunkId} {
          allow read, write, delete: if isValidId(diaryId);
        }
      }
    }

    function isValidAppVersion(data) {
      return data.keys().hasAll(['lastBuildId', 'deployCount', 'buildTime', 'updatedAt'])
        && data.keys().hasOnly(['lastBuildId', 'deployCount', 'buildTime', 'updatedAt'])
        && data.lastBuildId is string && data.lastBuildId.size() > 0 && data.lastBuildId.size() <= 64
        && data.deployCount is number && data.deployCount >= 1 && data.deployCount <= 1000000
        && data.buildTime is string && data.buildTime.size() > 0 && data.buildTime.size() <= 32
        && data.updatedAt is number;
    }

    // Published build version counter metadata (increments +1 only when buildId changes)
    match /app_meta/{docId} {
      allow get: if docId == 'version';
      allow list: if false;
      allow create: if docId == 'version'
        && isValidAppVersion(request.resource.data)
        && request.resource.data.deployCount == 1;
      allow update: if docId == 'version'
        && isValidAppVersion(request.resource.data)
        && request.resource.data.lastBuildId != resource.data.lastBuildId
        && request.resource.data.deployCount == resource.data.deployCount + 1;
      allow delete: if false;
    }
  }
}
